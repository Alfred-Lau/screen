{
  "name": "solokit-screen",
  "version": "0.1.0",
  "description": "Production-ready React components for AI products \u2014 chat, agents, docs, dashboards and marketing. One file each, one theme.",
  "license": "MIT",
  "homepage": "https://screen.solokit.run",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alfred-Lau/solokit-element.git"
  },
  "keywords": [
    "react",
    "components",
    "shadcn",
    "registry",
    "ai",
    "chatbot",
    "tailwindcss",
    "nextjs"
  ],
  "files": [
    "lib",
    "styles",
    "public/r",
    "registry.json",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "registry:build": "shadcn build && node scripts/build-agent-catalog.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "verify": "pnpm typecheck && pnpm test && pnpm registry:build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "next": ">=14",
    "next-intl": "^4"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.23.22",
    "lucide-react": "^0.544.0",
    "prismjs": "^1.30.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.5.2",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.1.15",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^30.1.3",
    "next": ">=14",
    "next-intl": "^4.3.9",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "next-intl": {
      "optional": true
    }
  }
}
